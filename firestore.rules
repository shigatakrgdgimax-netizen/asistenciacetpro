rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esDni(id) { return id.matches('^[0-9]{8}$'); }
    function texto(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function programaValido(p) {
      return p in ['Informática', 'Peluquería y Barbería', 'Corte y Ensamblaje'];
    }

    // Estudiantes: solo se puede leer UNO si se conoce su DNI. No se puede listar ni modificar.
    match /estudiantes/{dni} {
      allow get: if esDni(dni);
      allow list: if false;
      allow create: if esDni(dni)
        && request.resource.data.keys().hasOnly(['nombres', 'apellidos', 'programa', 'creado'])
        && request.resource.data.keys().hasAll(['nombres', 'apellidos', 'programa', 'creado'])
        && texto(request.resource.data.nombres, 2, 60)
        && texto(request.resource.data.apellidos, 2, 60)
        && programaValido(request.resource.data.programa)
        && request.resource.data.creado == request.time
        && existsAfter(/databases/$(database)/documents/estudiantes_privado/$(dni));
      allow update, delete: if false;
    }

    // Datos privados (celular): se pueden crear, pero NUNCA leer desde la web.
    match /estudiantes_privado/{dni} {
      allow read: if false;
      allow create: if esDni(dni)
        && request.resource.data.keys().hasOnly(['celular', 'creado'])
        && request.resource.data.celular is string
        && request.resource.data.celular.matches('^9[0-9]{8}$')
        && request.resource.data.creado == request.time;
      allow update, delete: if false;
    }

    // Marcas diarias: id = DNI_AAAA-MM-DD. Al no permitir update, una segunda marca el mismo día falla.
    match /marcas/{clave} {
      allow get: if clave.matches('^[0-9]{8}_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow list: if false;
      allow create: if clave.matches('^[0-9]{8}_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && exists(/databases/$(database)/documents/estudiantes/$(clave.split('_')[0]))
        && request.resource.data.keys().hasOnly(['fecha', 'creado'])
        && request.resource.data.fecha == clave.split('_')[1]
        && request.resource.data.creado == request.time;
      allow update, delete: if false;
    }

    // Asistencias: lista pública SIN DNI completo ni teléfono. Solo se pueden crear.
    match /asistencias/{id} {
      allow get: if false;
      allow list: if request.query.limit <= 500;
      allow create: if request.resource.data.keys().hasOnly(['nombre', 'programa', 'fecha', 'hora', 'dniOculto', 'timestamp'])
        && request.resource.data.keys().hasAll(['nombre', 'programa', 'fecha', 'hora', 'dniOculto', 'timestamp'])
        && texto(request.resource.data.nombre, 3, 125)
        && programaValido(request.resource.data.programa)
        && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.hora.matches('^[0-9]{2}:[0-9]{2}:[0-9]{2}$')
        && request.resource.data.dniOculto.matches('^[0-9]{2}[*]{4}[0-9]{2}$')
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // Todo lo demás queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
